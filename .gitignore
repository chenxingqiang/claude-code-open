# Security - Never commit real API keys
*.env
.env.*
**/secrets/**
**/*secret*
**/*key*
# Allow documentation images
!asset/*key*.png
!**/*key*.png

# Logs
*.log
logs/

# OS Files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Dependencies
node_modules/

# Auto-generated model catalog (regenerated at runtime from OpenRouter / static defaults)
claude-llm-gateway/config/providers.json
# Local OpenRouter catalog cache (runtime fallback)
claude-llm-gateway/config/openrouter-cache.json
