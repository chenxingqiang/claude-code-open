{
  "root": true,
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-empty": "warn",
    "no-useless-catch": "warn",
    "no-case-declarations": "warn",
    "no-prototype-builtins": "warn",
    "no-async-promise-executor": "warn",
    "no-useless-escape": "warn",
    "no-control-regex": "off"
  }
}
