# Claude LLM Gateway Configuration
# Copy this file to .env and configure your API keys

# Gateway Settings
GATEWAY_PORT=8765
GATEWAY_HOST=localhost
LOG_LEVEL=info

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (optional - for direct Anthropic access)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Cohere
COHERE_API_KEY=your_cohere_api_key_here

# Hugging Face
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here

# Groq
GROQ_API_KEY=your_groq_api_key_here

# Perplexity AI
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# AI21 Studio
AI21_API_KEY=your_ai21_api_key_here

# NVIDIA AI
NVIDIA_API_KEY=your_nvidia_api_key_here

# Fireworks AI
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Together AI
TOGETHER_API_KEY=your_together_api_key_here

# Replicate
REPLICATE_API_KEY=your_replicate_api_key_here

# Local LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
LLAMACPP_BASE_URL=http://localhost:8080

# Gateway Security
GATEWAY_API_KEY=gateway-bypass-token-change-this

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Caching
ENABLE_CACHE=true
CACHE_TTL_SECONDS=300

# Automatic model-info sync (OpenRouter)
# The gateway auto-updates model IDs, pricing and capabilities from the public
# OpenRouter models API so you don't have to configure them by hand.
ENABLE_OPENROUTER_SYNC=true
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=20000

# Dynamic call layer: all completions are sent to OpenRouter's unified endpoint
# using the synced model id. Only a single OPENROUTER_API_KEY is required
# (the old per-vendor llm-interface injection has been removed).
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional OpenRouter attribution headers.
OPENROUTER_REFERER=https://github.com/chenxingqiang/claude-code-open
OPENROUTER_TITLE=Claude LLM Gateway

# Reasoning models: minimum answer budget so hidden reasoning tokens don't
# consume the whole max_tokens and leave an empty answer.
REASONING_MIN_TOKENS=1024
# Set to true to surface a model's reasoning summary in responses/streams.
EXPOSE_REASONING=false
# How long a saved catalog is considered fresh before an automatic refresh.
MODEL_SYNC_TTL_HOURS=24
# Background auto-refresh interval while the server runs (defaults to TTL in minutes).
MODEL_SYNC_INTERVAL_MINUTES=1440
